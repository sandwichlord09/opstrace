# ==============================================================================
# OpsTrace API Environment Configuration Template (apps/api/.env)
# ==============================================================================

# Server Configuration
PORT=3001
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# Database Connection (Prisma & PostgreSQL 16)
DATABASE_URL="postgresql://opstrace:opstrace_secret@localhost:5432/opstracedb?schema=public"

# Redis Cache & Background Jobs (BullMQ / ioredis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# S3-Compatible Object Storage Configuration (SeaweedFS)
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_EVIDENCE=opstrace-evidence

# Authentication & JWT
JWT_SECRET=super_secret_jwt_key_opstrace_dev_change_in_production
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_dev_change_in_production
JWT_REFRESH_EXPIRATION=30d
