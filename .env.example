# ==============================================================================
# OpsTrace Root Environment Configuration Template
# Duplicate this file to .env and adjust credentials as needed for local dev.
# ==============================================================================

# Database (PostgreSQL 16)
POSTGRES_USER=opstrace
POSTGRES_PASSWORD=opstrace_secret
POSTGRES_DB=opstracedb
POSTGRES_PORT=5432
DATABASE_URL=postgresql://opstrace:opstrace_secret@localhost:5432/opstracedb?schema=public

# Redis (Redis 7)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Object Storage (SeaweedFS S3-Compatible)
S3_PORT=9000
S3_ENDPOINT=localhost
S3_USE_SSL=false
S3_BUCKET_NAME=opstrace-evidence

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_opstrace_dev_change_in_production
JWT_EXPIRATION=7d

# Application Ports
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
